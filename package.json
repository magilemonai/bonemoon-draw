{
  "name": "bonemoon-draw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsx scripts/inline-art.ts && vite build --mode single && python3 scripts/artifact-fragment.py && tsx scripts/inline-art.ts --clear",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim.ts",
    "art-prompts": "tsx scripts/art-prompts.ts",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "review-packet": "tsx scripts/review-packet.ts"
  },
  "dependencies": {
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.2"
}
